# --- Supabase (required) ---
# Project URL and the PUBLIC anon/publishable key. The secret/service key must
# NEVER be used in the browser — all privileged actions go through RLS +
# SECURITY DEFINER RPCs.
#
# Vite only exposes variables prefixed with VITE_ to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
