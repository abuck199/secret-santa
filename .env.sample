# --- Supabase (required) ---
# Project URL and the PUBLIC anon key. The service key must NEVER be used in the
# browser anymore — all privileged actions go through RLS + SECURITY DEFINER RPCs.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# --- Google Gemini (optional) ---
# Enables the AI gift-suggestion helper. Leave blank to hide that feature.
REACT_APP_GEMINI_API_KEY=
